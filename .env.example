# Copy to .env for local development. Never commit populated production secrets.
CROSSLENS_ENVIRONMENT=development
CROSSLENS_LOG_LEVEL=INFO
CROSSLENS_API_HOST=0.0.0.0
CROSSLENS_API_PORT=8000
# Add credentials only in your untracked .env when an adapter needs them.
CROSSLENS_POSTGRES_DSN=postgresql://crosslens@postgres:5432/crosslens
CROSSLENS_NEO4J_URI=bolt://neo4j:7687
CROSSLENS_NEO4J_USER=neo4j
# CROSSLENS_NEO4J_PASSWORD=
CROSSLENS_CHROMA_HOST=chromadb
CROSSLENS_CHROMA_PORT=8000
CROSSLENS_REDIS_URL=redis://redis:6379/0
CROSSLENS_CELERY_BROKER_URL=redis://redis:6379/0
CROSSLENS_CELERY_RESULT_BACKEND=redis://redis:6379/1
CROSSLENS_FILE_STORE_ROOT=./data
CROSSLENS_MAX_UPLOAD_BYTES=52428800
CROSSLENS_LLM_PROVIDER=disabled
CROSSLENS_VLM_PROVIDER=disabled
CROSSLENS_EMBEDDING_PROVIDER=disabled

# Development-only values used by compose.yaml. Replace for any shared environment.
POSTGRES_DB=crosslens
POSTGRES_USER=crosslens
POSTGRES_PASSWORD=change-me-development-only
NEO4J_PASSWORD=change-me-development-only
